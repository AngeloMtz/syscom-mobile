# URL base de la API REST de SYSCOM.
# Dispositivo fisico: IP LAN de la PC (ej. http://192.168.1.10:4000/api) o la URL de Render.
EXPO_PUBLIC_API_URL=https://syscom-backend-production-dced.up.railway.app/api

# Clave PUBLICABLE de Stripe en modo prueba (pk_test_...). Solo en tu .env local; sin valor aqui.
# NUNCA pongas la clave secreta (sk_) en la app.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
