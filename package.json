{
  "name": "syscom-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stripe/stripe-react-native": "0.64.0",
    "@tanstack/react-query": "^5.104.0",
    "@types/jest": "29.5.14",
    "axios": "^1.20.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "verificar-entorno": "node scripts/verificar-entorno.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/__tests__/fixtures/",
      "<rootDir>/src/__tests__/utils/"
    ],
    "collectCoverageFrom": [
      "src/**/validation.ts",
      "src/features/ar/hooks/*.ts",
      "src/features/ar/modelViewerHtml.ts",
      "src/features/ar/repositories/*.ts",
      "src/features/ar/selectors.ts",
      "src/features/addresses/addressErrors.ts",
      "src/features/addresses/addressSelectors.ts",
      "src/features/addresses/addressValidation.ts",
      "src/features/addresses/checkoutStore.ts",
      "src/features/addresses/hooks/*.ts",
      "src/features/addresses/repositories/*.ts",
      "src/features/addresses/components/AddressCard.tsx",
      "src/features/addresses/components/AddressForm.tsx",
      "src/features/auth/hooks/*.ts",
      "src/features/auth/repositories/authRepository.ts",
      "src/features/cart/cartSelectors.ts",
      "src/features/cart/components/CartItemRow.tsx",
      "src/features/cart/components/CartSummary.tsx",
      "src/features/cart/hooks/*.ts",
      "src/features/cart/repositories/*.ts",
      "src/features/catalog/hooks/*.ts",
      "src/features/catalog/repositories/*.ts",
      "src/features/catalog/searchFilters.ts",
      "src/features/catalog/productDetail.ts",
      "src/features/favorites/favoriteSelectors.ts",
      "src/features/favorites/hooks/*.ts",
      "src/features/favorites/repositories/*.ts",
      "src/features/institutional/hooks/*.ts",
      "src/features/institutional/repositories/*.ts",
      "src/features/orders/components/OrderCard.tsx",
      "src/features/orders/components/OrderDetailView.tsx",
      "src/features/orders/components/OrderStatusBadge.tsx",
      "src/features/orders/hooks/*.ts",
      "src/features/orders/orderFormat.ts",
      "src/features/orders/orderList.ts",
      "src/features/orders/repositories/*.ts",
      "src/features/payments/hooks/*.ts",
      "src/features/payments/paymentConfig.ts",
      "src/features/payments/paymentErrors.ts",
      "src/features/payments/paymentPolling.ts",
      "src/features/payments/paymentReducer.ts",
      "src/features/payments/paymentSelectors.ts",
      "src/features/payments/paymentStore.ts",
      "src/features/payments/repositories/*.ts",
      "src/features/profile/hooks/*.ts",
      "src/features/profile/repositories/*.ts",
      "src/features/reviews/components/ProductReviewsSection.tsx",
      "src/features/reviews/components/ReviewCard.tsx",
      "src/features/reviews/components/ReviewSummary.tsx",
      "src/features/reviews/components/StarRating.tsx",
      "src/features/reviews/hooks/*.ts",
      "src/features/reviews/repositories/*.ts",
      "src/features/reviews/reviewSelectors.ts",
      "src/shared/api/client.ts",
      "src/shared/api/errorMessage.ts",
      "src/shared/api/queryClient.ts",
      "src/shared/api/secureToken.ts",
      "src/shared/hooks/*.ts",
      "src/shared/store/*.ts",
      "src/shared/storage/*.ts",
      "src/shared/utils/format.ts",
      "src/shared/utils/html.ts",
      "src/shared/utils/url.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80,
        "functions": 80,
        "branches": 70
      }
    }
  }
}
